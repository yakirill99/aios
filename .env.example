# Порт дашборда на хосте
PORT=8000

# Каталог с результатами прогонов (вне репозитория)
AIOS_DATA_DIR=~/aios-data

# Команда запуска цикла оптимизации для кнопки "Запустить прогон".
# Пусто — ручка честно скажет, что запускать нечего, дашборд при этом
# работает на демо-данных.
AIOS_RUN_CMD=
# AIOS_RUN_CMD=python scripts/rolling_horizon.py --config configs/run.yaml

# DEBUG даёт подробный лог
AIOS_LOG_LEVEL=INFO
