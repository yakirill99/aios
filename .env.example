# Порт дашборда на хосте
PORT=8000

# Каталог с результатами прогонов и очередью (вне репозитория)
AIOS_DATA_DIR=~/aios-data

# 1 — меню запуска пропадает, ручки запуска отвечают 403.
# Так собирается сборка, которая уезжает организаторам: жюри не сможет
# случайно запустить получасовой расчёт посреди защиты.
AIOS_READONLY=0

# Команда запуска цикла оптимизации. Читает её ВОРКЕР, не дашборд.
# Воркер дописывает к ней --config <оверлей> и --out <каталог прогона>.
AIOS_RUN_CMD=
# AIOS_RUN_CMD=python scripts/rolling_horizon.py

# DEBUG даёт подробный лог
AIOS_LOG_LEVEL=INFO
