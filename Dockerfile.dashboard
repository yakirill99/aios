# syntax=docker/dockerfile:1
#
# Образ дашборда. Отдельный от scripts/Dockerfile, где живёт OPM Flow:
# у них разный цикл пересборки и разный набор зависимостей.
#
# Фронт не собирается — обычные HTML и JS, node в образе не нужен.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AIOS_WEB_DIR=/app/ui/web \
    AIOS_DEMO_DIR=/app/ui/demo \
    AIOS_LIVE_DIR=/data/rolling \
    AIOS_PROBES_DIR=/data/probes \
    AIOS_SUBMISSION_DIR=/app/submission

WORKDIR /app

# ---- Зависимости отдельным слоем: пересобирается только при правке
#      pyproject.toml, а не на каждое изменение кода ----
COPY pyproject.toml ./
RUN mkdir -p src/aios/dashboard \
 && touch src/aios/dashboard/__init__.py \
 && pip install --no-cache-dir .

# ---- Только код дашборда: остальное из src/aios сюда не едет ----
COPY src/aios/dashboard/ ./src/aios/dashboard/
COPY ui/ ./ui/

# Слой выше положил в site-packages пустую заглушку пакета — она была
# нужна только чтобы закешировать установку зависимостей. Переставляем
# пакет уже с реальным кодом: --no-deps, поэтому зависимости не
# пересобираются и кеш слоя выше не пропадает.
RUN pip install --no-cache-dir --no-deps --force-reinstall .

RUN mkdir -p /data/rolling /data/probes /app/submission \
 && useradd --create-home appuser \
 && chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status==200 else 1)"

CMD ["uvicorn", "aios.dashboard.server:app", "--host", "0.0.0.0", "--port", "8000"]
